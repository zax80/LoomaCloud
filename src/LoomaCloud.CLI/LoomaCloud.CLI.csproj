<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>LoomaCloud.CLI</RootNamespace>
    <AssemblyName>looma</AssemblyName>
    <!-- One shared id across CLI, MCP.Server and MAUI Desktop, so a single
         "Manage User Secrets" file (%APPDATA%\Microsoft\UserSecrets\<id>\secrets.json)
         serves all three. See docs/secrets.md. -->
    <UserSecretsId>a7d2c4e1-3b5f-4c68-9e0a-1f2b3c4d5e6f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoomaCloud.Application\LoomaCloud.Application.csproj" />

    <!-- Composition-root exception to "clients depend only on Application"
         (CLAUDE.md rule 1): Program.cs is the outermost composition root and
         is where DI gets wired to concrete implementations — the brief's own
         architecture section says exactly this ("Only Program.cs DI wiring
         changes between shapes"). No command handler under Commands/
         references any of these three projects; only Program.cs does, and
         it picks between the Infrastructure.* pair (Standalone mode) and
         LoomaCloud.MCP.Client (McpClient mode) based on Deployment:Mode. -->
    <ProjectReference Include="..\LoomaCloud.Infrastructure.VectorStore.Qdrant\LoomaCloud.Infrastructure.VectorStore.Qdrant.csproj" />
    <ProjectReference Include="..\LoomaCloud.Infrastructure.Llm\LoomaCloud.Infrastructure.Llm.csproj" />
    <ProjectReference Include="..\LoomaCloud.Infrastructure.LocalStore\LoomaCloud.Infrastructure.LocalStore.csproj" />
    <ProjectReference Include="..\LoomaCloud.Infrastructure.WebSearch.DuckDuckGo\LoomaCloud.Infrastructure.WebSearch.DuckDuckGo.csproj" />
    <ProjectReference Include="..\LoomaCloud.MCP.Client\LoomaCloud.MCP.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions pinned centrally in Directory.Packages.props.

         Program.cs's McpClient-mode branch calls
         services.AddOptions<RagOptions>().Bind(...) directly (so
         SearchCommand's diagnostic threshold display works without pulling
         in AddLoomaCloudApplicationUseCases' Infrastructure-dependent
         registrations) — that needs Microsoft.Extensions.Options /
         .ConfigurationExtensions, already available transitively through
         the LoomaCloud.Application ProjectReference below (which references
         them directly itself), so no separate PackageReference is added
         here for it. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
  </ItemGroup>

</Project>
