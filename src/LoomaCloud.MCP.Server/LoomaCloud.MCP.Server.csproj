<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>LoomaCloud.MCP.Server</RootNamespace>
    <AssemblyName>looma-mcp-server</AssemblyName>
    <!-- Same id as LoomaCloud.CLI / MAUI Desktop — see docs/secrets.md.
         Microsoft.NET.Sdk.Web already ships the UserSecrets package. -->
    <UserSecretsId>a7d2c4e1-3b5f-4c68-9e0a-1f2b3c4d5e6f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoomaCloud.Application\LoomaCloud.Application.csproj" />

    <!-- Composition-root exception to "clients depend only on Application"
         (CLAUDE.md rule 1), identical to LoomaCloud.CLI: Program.cs is the
         standalone-server composition root and is the only file in this
         project allowed to reference these namespaces. Tools/ depends only
         on LoomaCloud.Application's use-case interfaces. -->
    <ProjectReference Include="..\LoomaCloud.Infrastructure.VectorStore.Qdrant\LoomaCloud.Infrastructure.VectorStore.Qdrant.csproj" />
    <ProjectReference Include="..\LoomaCloud.Infrastructure.Llm\LoomaCloud.Infrastructure.Llm.csproj" />
    <ProjectReference Include="..\LoomaCloud.Infrastructure.WebSearch.DuckDuckGo\LoomaCloud.Infrastructure.WebSearch.DuckDuckGo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions pinned centrally in Directory.Packages.props.

         Microsoft.Extensions.Configuration.Json / .Binder are deliberately
         NOT referenced here even though Program.cs uses AddJsonFile/Get<T>()
         — Microsoft.NET.Sdk.Web's FrameworkReference to Microsoft.AspNetCore.App
         already ships both transitively, and NuGet's package-pruning flagged
         the explicit references as redundant (NU1510) the first time this
         was built for real. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

</Project>
